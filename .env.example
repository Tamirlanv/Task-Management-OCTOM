APP_ENV=development
DATABASE_URL=postgresql+asyncpg://taskman:local-development-only@127.0.0.1:5433/taskman
REDIS_URL=redis://127.0.0.1:6380/0
# Generate a private value before running: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=task-management-api
JWT_AUDIENCE=task-management-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000
CORS_ORIGINS=["http://localhost:5173"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=10
DEPENDENCY_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
# Used by local Compose; never reuse these local credentials in production.
POSTGRES_USER=taskman
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=taskman
